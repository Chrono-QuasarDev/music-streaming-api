NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://username:password@localhost:5432/music_streamdb
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=1d
B2_ENDPOINT=url-to-your-b2-endpoint
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-application-key
B2_BUCKET_NAME=your-b2-bucket-name
SEED_ARTIST_PASSWORD=replace-with-a-seed-password