{
  "name": "spotify-api",
  "version": "1.0.0",
  "description": "A music streaming api my very own spotify",
  "license": "ISC",
  "author": "QuasarDev",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "seed:playlist-songs": "sequelize-cli db:seed --seed seedPlaylistSongs.js",
    "seed:artists": "node src/database/seeders/seedArtists.js",
    "seed:songs": "node src/database/seeders/seedSongs.js",
    "seed": "npm run seed:artists && npm run seed:songs",
    "start": "node --watch server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "music-metadata": "^11.16.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
